{
  "name": "leaflet-hotline-transparency",
  "version": "0.4.0",
  "description": "A Leaflet plugin for drawing colored gradients along a polyline",
  "main": "src/leaflet.hotline.js",
  "module": "dist/leaflet.hotline.js",
  "types": "dist/leaflet.hotline.d.ts",
  "scripts": {
    "test": "npm run lint",
    "lint": "eslint src/leaflet.hotline.js",
    "clean": "rm -rf dist",
    "beautify": "uglifyjs src/leaflet.hotline.js -b --comments /iosphere/ > dist/leaflet.hotline.js",
    "minify": "uglifyjs src/leaflet.hotline.js -c -m --comments /iosphere/ > dist/leaflet.hotline.min.js",
    "prebuild": "npm run clean && mkdir -p dist",
    "build": "npm run test && npm run beautify && npm run minify && npm run copy-types",
    "copy-types": "cp src/leaflet.hotline.d.ts dist/leaflet.hotline.d.ts"
  },
  "repository": {
    "type": "git",
    "url": "git://github.com/sailtrace/Leaflet.hotline.transparency.git"
  },
  "keywords": [
    "Leaflet",
    "plugin",
    "canvas",
    "visualization",
    "path",
    "gradient",
    "heatmap",
    "color",
    "colour"
  ],
  "author": "Nikolas Molinari",
  "license": "BSD-2-Clause",
  "bugs": {
    "url": "https://github.com/sailtrace/Leaflet.hotline.transparency/issues"
  },
  "homepage": "https://sailtrace.github.io/Leaflet.hotline.transparency/demo/",
  "devDependencies": {
    "eslint": "^0.23.0",
    "uglify-js": "^2.4.23"
  },
  "peerDependencies": {
    "leaflet": "^1.0.0"
  }
}
